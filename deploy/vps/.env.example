# Domínios (ex.: app.suaempresa.com.br e api.suaempresa.com.br)
APP_DOMAIN=app.suaempresa.com.br
API_DOMAIN=api.suaempresa.com.br

# Senha do superusuário do Postgres (só administração, a API não usa)
POSTGRES_PASSWORD=

# Senha do app_api: a MESMA definida em database/00_roles.sql,
# codificada para URL (# → %23, @ → %40, ! pode ficar)
APP_API_PASSWORD_URLENCODED=TROQUE-Kq7%23vR2m!Lp9xW4z

# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# db (padrão) | local | s3
STORAGE_DRIVER=db
