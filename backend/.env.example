# API IaHope Gestão — Desenvolvido por Edivaldo.Nascimento - IaHope-Technology
PORT=3000

# SEMPRE o usuário app_api (nunca o dono do banco / neondb_owner / postgres).
# A API se recusa a subir se o usuário ignorar o RLS.
#   Neon:  postgres://app_api:SENHA@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#   VPS:   postgres://app_api:SENHA@db:5432/gestao
# Caracteres especiais na senha precisam ir codificados na URL (# → %23, @ → %40).
DATABASE_URL=postgres://app_api:SENHA@localhost:5432/gestao
DB_POOL_MAX=5

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL pública da API (no Render pode deixar vazio: usa RENDER_EXTERNAL_URL)
PUBLIC_BASE_URL=
# Domínio(s) do app Web, separados por vírgula. * libera todos.
CORS_ORIGIN=*

# Logos: db (padrão, grátis) | local (disco da VPS) | s3 (R2, Supabase Storage, MinIO)
STORAGE_DRIVER=db
UPLOAD_DIR=uploads
# Só para STORAGE_DRIVER=s3 — exemplo Cloudflare R2:
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=iahope-logos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
